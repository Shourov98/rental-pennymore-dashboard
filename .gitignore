# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.zip

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.pid

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.sample

# vercel
.vercel

# local IDE/workspace state (do not commit executable editor tasks)
.vscode/
.idea/
*.code-workspace

# local package-manager and tool caches
.pnpm-store/
.cache/
.turbo/

# local credentials and certificates
*.key
*.p12
*.pfx
.envrc

# typescript
*.tsbuildinfo
next-env.d.ts
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
